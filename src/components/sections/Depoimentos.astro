---
/**
 * Depoimentos reais e autorizados. Em produção só entram os que têm
 * consentimento. Nunca geram avaliações estruturadas (estrelas/nota).
 */
import site, { depoimentosPublicaveis } from '@/lib/site';
import Icon from '@/components/ui/Icon.astro';
const lista = depoimentosPublicaveis(site.c);
---

<section id="depoimentos" class="dep" aria-labelledby="dep-title" data-section="depoimentos" data-carousel>
  <div class="dep__inner">
    <h2 id="dep-title" class="dep__eyebrow">
      Depoimentos
      {site.marcarModulos && <span class="module-tag">Módulo opcional</span>}
    </h2>
    <div class="dep__slides" data-reveal="quote">
      {
        lista.map((d, i) => (
          <figure class="dep__slide" data-slide aria-roledescription="depoimento" aria-label={`${i + 1} de ${lista.length}`}>
            <blockquote class="dep__quote">
              <p>“{d.texto}”</p>
            </blockquote>
            <figcaption class="dep__who">
              {d.autor} · {d.link ? <a href={d.link} rel="noopener" target="_blank">{d.fonte}</a> : d.fonte}
              {d.data && <> · {d.data}</>}
            </figcaption>
          </figure>
        ))
      }
    </div>
    {
      lista.length > 1 && (
        <div class="dep__nav">
          <button type="button" class="dep__btn" aria-label="Depoimento anterior" data-prev>
            <Icon name="arrow-left" size={16} />
          </button>
          <span class="dep__count" data-count aria-hidden="true">1 / {lista.length}</span>
          <button type="button" class="dep__btn" aria-label="Próximo depoimento" data-next>
            <Icon name="arrow-right" size={16} />
          </button>
          <span class="sr-only" aria-live="polite" data-live />
        </div>
      )
    }
  </div>
</section>

<style>
  .dep {
    background: var(--c-surface-alt);
  }
  .dep__inner {
    max-width: var(--max);
    margin-inline: auto;
    padding: 110px var(--gutter) 120px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .dep__eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--f-sans);
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--c-muted);
  }
  .dep__slides {
    margin-top: 34px;
    max-width: 900px;
    display: grid;
  }
  .dep__slide {
    margin: 0;
    grid-area: 1 / 1;
  }
  :global(.carousel-ready) .dep__slide[hidden] {
    display: none;
  }
  html:not(.js) .dep__slide + .dep__slide {
    grid-area: auto;
    margin-top: 40px;
  }
  .dep__slide.is-entering .dep__quote,
  .dep__slide.is-entering .dep__who {
    animation: quote-in 0.7s var(--ease-out) both;
  }
  .dep__slide.is-entering .dep__who {
    animation-delay: 0.12s;
  }
  @keyframes quote-in {
    from {
      opacity: 0;
      transform: translateY(12px);
      filter: blur(3px);
    }
  }
  .dep__quote {
    font-family: var(--f-serif);
    font-style: italic;
    font-size: var(--fs-quote);
    line-height: 1.2;
    color: #2a1e21;
  }
  .dep__who {
    margin-top: 26px;
    font-size: 14px;
    color: var(--c-text);
  }
  .dep__nav {
    margin-top: 34px;
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .dep__btn {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid var(--c-surface-alt-line);
    background: transparent;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition:
      background-color 0.25s,
      border-color 0.25s;
  }
  .dep__btn:hover {
    background: var(--c-surface);
    border-color: var(--c-ink);
  }
  .dep__count {
    font-size: 13px;
    color: var(--c-text);
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 899px) {
    .dep__inner {
      padding: 80px 20px 88px;
    }
  }
</style>
