---
/**
 * Marca da clínica. Sem logo configurado, usa a composição tipográfica do
 * design: arco + nome em serif itálico + descritor em versalete.
 */
import { Image } from 'astro:assets';
import site from '@/lib/site';

interface Props {
  size?: 'lg' | 'md' | 'sm';
  descritor?: boolean;
  class?: string;
}
const { size = 'md', descritor = false, class: cls } = Astro.props;
const { marca } = site.c;
const logo = marca.logo;
const scale = { lg: 1, md: 0.82, sm: 0.62 }[size];
---

<span class:list={['wordmark', `wordmark--${size}`, cls]}>
  {
    logo ? (
      typeof logo.src === 'string' ? (
        <img src={logo.src} alt={logo.alt} height={Math.round(logo.altura * scale)} class="wordmark__img" />
      ) : (
        <Image src={logo.src} alt={logo.alt} height={Math.round(logo.altura * scale)} class="wordmark__img" />
      )
    ) : (
      <>
        <svg class="wordmark__arch" viewBox="0 0 20 24" fill="none" aria-hidden="true">
          <path d="M1.5 23V10a8.5 8.5 0 0 1 17 0v13" stroke="var(--c-primary)" stroke-width="1.7" />
        </svg>
        <span class="wordmark__name">{marca.nomeCurto}</span>
        {descritor && marca.descritor && <span class="wordmark__desc"> {marca.descritor}</span>}
        <span class="sr-only"> — página inicial</span>
      </>
    )
  }
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--c-ink);
    line-height: 1;
  }
  .wordmark__arch {
    width: 20px;
    height: 24px;
  }
  .wordmark__name {
    font-family: var(--f-serif);
    font-style: italic;
    font-size: 34px;
    line-height: 1;
  }
  .wordmark__desc {
    font-size: 10px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--c-muted);
    padding-top: 6px;
  }
  .wordmark--md {
    gap: 8px;
  }
  .wordmark--md .wordmark__arch {
    width: 16px;
    height: 20px;
  }
  .wordmark--md .wordmark__name {
    font-size: 27px;
  }
  .wordmark--sm .wordmark__arch {
    display: none;
  }
  .wordmark--sm .wordmark__name {
    font-size: 20px;
  }
  .wordmark__img {
    width: auto;
  }
</style>
