---
/** 00 · Hero — artboard Main (desktop) e MobileHero. */
import site from '@/lib/site';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Title from '@/components/ui/Title.astro';
import Icon from '@/components/ui/Icon.astro';
import WaLink from '@/components/ui/WaLink.astro';
import ArchPhoto from '@/components/ui/ArchPhoto.astro';
import QuickBooking from '@/components/forms/QuickBooking.astro';
import ToothSvg from './svg/ToothSvg.astro';
const { hero } = site.c;
const is3d = hero.visual === '3d';
---

<section id="inicio" class="panel hero" data-panel="hero" data-surface="light" aria-labelledby="hero-title" data-visual={hero.visual}>
  <div class="hero__inner">
    <div class="hero__copy" data-cine="hero-copy">
      <Eyebrow texto={hero.local} class="hero__eyebrow" />
      <Title as="h1" id="hero-title" class="hero__title" text={hero.titulo} />
      <p class="hero__text">{hero.texto}</p>
      <div class="hero__ctas">
        <a href="/#agendamento" class="btn btn--primary btn--lg">
          {hero.ctaPrimario}
          <Icon name="arrow-right" class="icon-shift" />
        </a>
        <WaLink class="btn btn--outline btn--lg">
          <Icon name="whatsapp" />
          Falar no WhatsApp
        </WaLink>
      </div>
    </div>
    {
      (hero.agendamentoRapido || hero.nota) && (
        <div class="hero__bottom" data-cine="hero-quick">
          {hero.agendamentoRapido && <QuickBooking />}
          {hero.nota && <p class="hero__note">{hero.nota}</p>}
        </div>
      )
    }
  </div>

  <div class="hero__visual" data-cine="hero-visual">
    <span class="hero__arch-line" aria-hidden="true" data-hero-arch-line />
    <div class="hero__arch" data-hero-arch data-surface="dark">
      {
        is3d ? (
          <div class="hero__tooth" data-anchor="hero">
            <ToothSvg id="hero-tooth" class="hero__tooth-svg view-fallback" />
            <canvas class="view-canvas" data-view="hero" aria-hidden="true" />
          </div>
        ) : (
          <ArchPhoto foto={hero.foto} rotulo="[Foto real — fachada ou recepção]" class="hero__photo" eager reveal={false} sizes="(max-width: 899px) 70vw, 500px" />
        )
      }
      <div class="hero__scroll" aria-hidden="true">
        Role para conhecer
        <span />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: max(100svh, 720px);
    overflow: hidden;
    background: var(--c-bg);
  }
  .hero__inner {
    position: relative;
    z-index: 2;
    max-width: var(--max);
    margin-inline: auto;
    min-height: inherit;
    padding: calc(88px + clamp(48px, 12vh, 108px)) var(--gutter) clamp(40px, 8.6vh, 78px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 48px;
  }
  .hero__copy {
    width: min(680px, 52%);
  }
  .hero__title {
    margin-top: 30px;
    font-family: var(--f-serif);
    font-size: var(--fs-hero);
    line-height: 0.98;
    letter-spacing: -0.015em;
  }
  .hero__text {
    margin-top: 30px;
    max-width: 480px;
    font-size: var(--fs-lead);
    line-height: 1.6;
    color: var(--c-text);
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 36px;
  }
  .hero__note {
    margin-top: 22px;
    font-size: 13px;
    color: var(--c-muted);
  }
  .hero__bottom {
    width: min(660px, 52%);
  }

  /* Arco com o dente (lado direito) */
  .hero__visual {
    position: absolute;
    z-index: 1;
    right: calc(var(--gutter) + 14px);
    bottom: 0;
    width: min(34.72vw, calc((100svh - 156px) * 0.672), 560px);
    aspect-ratio: 500 / 744;
  }
  .hero__arch-line {
    position: absolute;
    inset: -18px -18px 0 -18px;
    border: 1px solid var(--c-arch-line);
    border-bottom: 0;
    border-radius: 9999px 9999px 0 0;
  }
  .hero__arch {
    position: absolute;
    inset: 0;
    border-radius: 9999px 9999px 0 0;
    background: var(--c-primary);
    overflow: hidden;
  }
  .hero__tooth {
    position: absolute;
    left: 18.4%;
    top: 14.8%;
    width: 63.2%;
    height: 63.2%;
  }
  .hero__tooth-svg {
    position: absolute;
    inset: 0;
  }
  .hero__photo {
    position: absolute;
    inset: 0;
    border-radius: 0;
  }
  .hero__scroll {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 36px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    color: var(--c-on-primary-muted);
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }
  .hero__scroll span {
    display: block;
    width: 1px;
    height: 36px;
    background: currentColor;
    transform-origin: top;
    animation: scroll-hint 2.4s var(--ease-in-out) infinite;
  }
  @keyframes scroll-hint {
    0% {
      transform: scaleY(0);
    }
    45% {
      transform: scaleY(1);
      transform-origin: top;
    }
    55% {
      transform: scaleY(1);
      transform-origin: bottom;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }

  @media (max-width: 1239px) and (min-width: 900px) {
    .hero__copy {
      width: 56%;
    }
    .hero__bottom {
      width: 58%;
    }
    .hero__bottom :global(.quick__form) {
      gap: 14px;
      padding-left: 18px;
    }
  }

  /* Mobile — artboard MobileHero */
  @media (max-width: 899px) {
    .hero {
      min-height: calc(100svh - var(--mobile-bar-h));
      display: flex;
      flex-direction: column;
    }
    .hero__inner {
      flex: none;
      min-height: 0;
      padding: calc(64px + 22px) 20px 0;
      gap: 0;
    }
    .hero__copy {
      width: 100%;
    }
    .hero__title {
      margin-top: 18px;
      font-size: clamp(2.5rem, 1.2rem + 7.8vw, 3.4rem);
    }
    .hero__text {
      margin-top: 16px;
      font-size: 15px;
      line-height: 1.55;
    }
    .hero__ctas,
    .hero__bottom {
      display: none;
    }
    .hero__visual {
      position: relative;
      right: auto;
      margin: auto auto 0;
      padding-top: 28px;
      width: min(246px, 63vw);
      flex: none;
    }
    .hero__arch-line {
      inset: 16px -12px 0 -12px;
    }
    .hero__arch {
      top: 28px;
    }
    .hero__tooth {
      left: 20%;
      top: 11.5%;
      width: 60%;
      height: 56%;
    }
    .hero__scroll {
      display: none;
    }
  }
  @media (max-width: 899px) and (max-height: 700px) {
    .hero__visual {
      width: min(200px, 52vw);
    }
  }
  /* Modo cinema compacto: o arco termina acima da barra fixa e das barras do navegador */
  @media (max-width: 899px) {
    :global(html.is-cinema) .hero {
      padding-bottom: calc(var(--mobile-bar-h) + var(--cine-ui-bottom));
    }
    :global(html.is-cinema) .hero__inner {
      min-height: 0;
    }
  }
</style>
