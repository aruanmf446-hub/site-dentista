---
/**
 * Dente inteiro em porcelana (artboard Main). Primeira pintura do hero e
 * fallback quando WebGL não está disponível.
 */
interface Props {
  id: string;
  class?: string;
  shadow?: boolean;
}
const { id, class: cls, shadow = true } = Astro.props;
const P =
  'M70 150 C60 90 110 60 150 80 C175 92 185 70 200 68 C215 70 225 92 250 80 C290 60 340 90 330 150 C325 200 320 240 312 270 C305 330 300 400 280 470 C272 495 245 495 240 465 C232 410 222 350 200 340 C178 350 168 410 160 465 C155 495 128 495 120 470 C100 400 95 330 88 270 C80 240 75 200 70 150 Z';
---

<div class:list={['tooth-svg', cls]} aria-hidden="true">
  {shadow && <span class="tooth-svg__shadow" />}
  <svg viewBox="52 50 296 450" preserveAspectRatio="xMidYMid meet">
    <defs>
      <radialGradient id={`${id}-porc`} cx="36%" cy="28%" r="78%">
        <stop offset="0" stop-color="#FFFFFF" />
        <stop offset="0.42" stop-color="#F7F0ED" />
        <stop offset="0.78" stop-color="#DECCC8" />
        <stop offset="1" stop-color="#B59894" />
      </radialGradient>
      <linearGradient id={`${id}-shade`} x1="0" y1="0" x2="1" y2="0.3">
        <stop offset="0.45" stop-color="#3E0D18" stop-opacity="0" />
        <stop offset="1" stop-color="#3E0D18" stop-opacity="0.28" />
      </linearGradient>
      <filter id={`${id}-soft`}><feGaussianBlur stdDeviation="7" /></filter>
      <filter id={`${id}-soft2`}><feGaussianBlur stdDeviation="2.2" /></filter>
    </defs>
    <path d={P} fill={`url(#${id}-porc)`} />
    <path d={P} fill={`url(#${id}-shade)`} />
    <path d="M112 112 C145 128 172 104 200 108 C228 104 255 128 288 112" fill="none" stroke="#7A4650" stroke-opacity="0.25" stroke-width="4" filter={`url(#${id}-soft2)`} />
    <ellipse cx="138" cy="160" rx="30" ry="62" fill="#FFFFFF" opacity="0.7" filter={`url(#${id}-soft)`} />
    <ellipse cx="150" cy="92" rx="22" ry="9" fill="#FFFFFF" opacity="0.9" filter={`url(#${id}-soft2)`} />
  </svg>
</div>

<style>
  .tooth-svg {
    position: relative;
  }
  .tooth-svg svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(-9deg);
  }
  .tooth-svg__shadow {
    position: absolute;
    left: -0.6%;
    top: 91.5%;
    width: 101%;
    height: 9.4%;
    border-radius: 50%;
    background: var(--c-primary-dark);
    filter: blur(14px);
    opacity: 0.85;
  }
</style>
