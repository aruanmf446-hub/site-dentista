---
import { getImage } from 'astro:assets';
import serif400 from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import serifItalic from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';
import sans from '@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2?url';
import site, { siteUrl } from '@/lib/site';
import { buildTheme, themeToCss } from '@/lib/theme';
import { organizationLd } from '@/lib/seo';

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  /** caminho canônico, ex.: "/tratamentos/limpeza/" */
  path: string;
  jsonLd?: Record<string, unknown>[];
  cinema?: boolean;
  ogType?: 'website' | 'article';
}
const { title, description, path, jsonLd = [], cinema = false, ogType = 'website' } = Astro.props;
const c = site.c;
const base = siteUrl();
const canonical = `${base}${path}`;
const fullTitle = title ? `${title} · ${c.marca.nome}` : c.site.titulo;
const desc = description ?? c.site.descricao;
const noindex = site.demo || c.site.noindex;
const theme = buildTheme(c.marca.cores.primaria, c.marca.cores.secundaria);
let ogImage: string | undefined;
const share = c.site.imagemCompartilhamento;
if (share) {
  ogImage =
    typeof share === 'string'
      ? new URL(share, base).href
      : new URL((await getImage({ src: share, width: 1200, format: 'jpg' })).src, base).href;
}
const ld = [...(path === '/' ? organizationLd(c, base) : []), ...jsonLd];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{fullTitle}</title>
<meta name="description" content={desc} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<meta name="theme-color" content="#FCFAF8" />
<meta name="format-detection" content="telephone=no" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="sitemap" href="/sitemap.xml" />

<meta property="og:type" content={ogType} />
<meta property="og:locale" content="pt_BR" />
<meta property="og:site_name" content={c.marca.nome} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={desc} />
<meta property="og:url" content={canonical} />
{ogImage && <meta property="og:image" content={ogImage} />}
<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

<link rel="preload" href={sans} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={serif400} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={serifItalic} as="font" type="font/woff2" crossorigin />

<style is:inline set:html={themeToCss(theme)} />

<!--
  Decide o modo de experiência antes da primeira pintura (evita CLS):
  - is-cinema: desktop ≥ 900 px, sem "reduzir movimento" e com WebGL disponível.
  - motion: animações de conteúdo permitidas.
  Se o JS de animação não carregar em 4 s, o conteúdo volta a ficar visível.
-->
<script is:inline define:vars={{ cinema }}>
  (function () {
    var d = document.documentElement;
    d.classList.add('js');
    var rm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!rm) d.classList.add('motion');
    if (cinema && !rm && window.innerWidth >= 900 && 'WebGLRenderingContext' in window) d.classList.add('is-cinema');
    window.setTimeout(function () {
      if (!d.classList.contains('motion-ready')) d.classList.remove('motion');
    }, 4000);
  })();
</script>

{ld.map((obj) => <script type="application/ld+json" is:inline set:html={JSON.stringify(obj)} />)}
